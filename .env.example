# Email Signature Manager - Environment Configuration

# Server port
PORT=3456

# Base URL path (useful when behind a reverse proxy)
BASE_PATH=/email-signature

# Database file path
DB_PATH=./data/signatures.db

# Session secret (change this in production!)
SESSION_SECRET=change-me-to-a-random-string

# Public URL for logo URLs in signatures (e.g. https://yourdomain.com)
PUBLIC_URL=

# SMTP settings for test emails
SMTP_HOST=localhost
SMTP_PORT=25

# Default admin password (only used on first run if no admin exists)
DEFAULT_ADMIN_PASS=admin
